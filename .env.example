# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Turso (libSQL) Connection
# Local development: file:local.db
# Cloud production: libsql://your-database-name.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Celestial Worthy (Owner) User ID (Leave empty to auto-bind on first /celestial_worthy by group creator)
OWNER_ID=

# Admin Log Channel/Group ID
ADMIN_LOG_CHAT_ID=

# Port for webhook / health checks
PORT=3000
